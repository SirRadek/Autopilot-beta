{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopilot-beta.local/product-design-os/qa/profile-check-matrix.schema.json",
  "title": "Product Design OS Profile Check Matrix",
  "description": "Dual-track QA gate policy: maps every known QA check/issue code to a per-page-profile severity (blocking, advisory, skipped). Consuming gates fail closed: unknown codes and missing profile entries resolve to blocking.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "checks"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "autopilot-beta/pdos-profile-check-matrix@1"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "seo_led", "balanced", "brand_led", "experimental_showcase"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "seo_led": {
            "type": "string",
            "enum": ["blocking", "advisory", "skipped"]
          },
          "balanced": {
            "type": "string",
            "enum": ["blocking", "advisory", "skipped"]
          },
          "brand_led": {
            "type": "string",
            "enum": ["blocking", "advisory", "skipped"]
          },
          "experimental_showcase": {
            "type": "string",
            "enum": ["blocking", "advisory", "skipped"]
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
