{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopilot.local/product-design-os/library/preset.schema.json",
  "title": "Product Design Library Motion Preset",
  "description": "A curated motion/effect preset proven (or rejected) in real supervised-project work. Presets are pointers to project proof: demo_route and screenshots reference the supervised project, never hosted demo code in this repository.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "pattern_id",
    "status",
    "dependencies",
    "props",
    "demo_route",
    "screenshots",
    "prompt_examples",
    "performance_notes",
    "page_profiles"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "pattern_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Id of an existing pattern in patterns/pattern-manifest.json that this preset implements."
    },
    "status": {
      "type": "string",
      "enum": ["candidate", "proven", "anti_pattern"]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "npm package names required by the preset; empty for CSS/vanilla-only presets."
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "demo_route": {
      "type": "string",
      "minLength": 1,
      "description": "Pointer to a supervised-project route or repo where the preset runs; never code hosted in this repository."
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Repo-relative or project-relative screenshot paths that prove the preset."
    },
    "prompt_examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "performance_notes": {
      "type": "string",
      "minLength": 1
    },
    "page_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["seo_led", "balanced", "brand_led", "experimental_showcase"]
      }
    },
    "source_effect": {
      "type": "string",
      "minLength": 1,
      "description": "Optional origin of the effect (library source id or effect name) for provenance."
    },
    "notes": {
      "type": "string"
    }
  }
}
