{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopilot.local/product-design-os/recipes/recipe.schema.json",
  "title": "Product Design OS Recipe",
  "type": "object",
  "x_schema_version": "1.0.0",
  "additionalProperties": false,
  "required": [
    "id",
    "project_types",
    "priorities",
    "logic_priority",
    "design_priority",
    "motion_level",
    "allowed_pattern_ids",
    "blocked_assets",
    "tests_required"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "project_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "priorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "logic_priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "design_priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "motion_level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "visual_energy": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "seo_priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "allowed_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_pattern_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "required_sections": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocked_assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tests_required": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "minimum_seo_floor": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "design_seo_tradeoff": {
      "type": "string",
      "minLength": 1
    }
  }
}
