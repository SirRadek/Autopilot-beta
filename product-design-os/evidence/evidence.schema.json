{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopilot-beta.local/product-design-os/evidence/evidence.schema.json",
  "title": "Product Design OS Governance Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "claim_kind": {
            "const": "license"
          }
        }
      },
      "then": {
        "required": ["spdx_license"]
      }
    },
    {
      "if": {
        "properties": {
          "claim_kind": {
            "const": "library_doc"
          }
        }
      },
      "then": {
        "required": ["library"]
      }
    }
  ],
  "required": [
    "id",
    "schema_version",
    "claim",
    "claim_kind",
    "source",
    "source_date",
    "freshness_ttl_days",
    "covered_claim",
    "fallback"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "claim_kind": {
      "type": "string",
      "enum": ["library_doc", "license", "clean_room", "source", "freshness"]
    },
    "library": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "source_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "freshness_ttl_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 365
    },
    "covered_claim": {
      "type": "string",
      "minLength": 1
    },
    "fallback": {
      "type": "string",
      "minLength": 1
    },
    "spdx_license": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  }
}
