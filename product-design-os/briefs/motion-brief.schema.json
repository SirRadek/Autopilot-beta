{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopilot.local/product-design-os/briefs/motion-brief.schema.json",
  "title": "Product Design OS Motion Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "intent",
    "page_profile",
    "driver",
    "objects",
    "states",
    "constraints",
    "acceptance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "implemented", "rejected"]
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "feeling"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "feeling": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "page_profile": {
      "type": "string",
      "enum": ["seo_led", "balanced", "brand_led", "experimental_showcase"]
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "section"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["scroll", "hover", "time", "cursor", "route_transition"]
        },
        "range": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "type": {
            "type": "string",
            "enum": ["dom_text", "dom_element", "css_overlay", "svg", "canvas_2d", "webgl"]
          },
          "selector": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "type": "string",
            "minLength": 1
          },
          "must_remain_dom": {
            "type": "boolean",
            "description": "Defaults to true for dom_text objects; dom_text stays real DOM unless explicitly waived.",
            "default": true
          }
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["p"],
        "properties": {
          "p": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        }
      }
    },
    "interpolation": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reduced_motion", "mobile"],
      "properties": {
        "screenshot_progress": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "default": [0, 0.25, 0.5, 0.75, 1]
        },
        "reduced_motion": {
          "type": "string",
          "minLength": 1
        },
        "mobile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reference": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    }
  }
}
