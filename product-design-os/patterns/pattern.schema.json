{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopilot.local/product-design-os/patterns/pattern.schema.json",
  "title": "Product Design OS UX Pattern",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "use_case",
    "good_for",
    "bad_for",
    "complexity",
    "usability",
    "mobile_quality",
    "requires",
    "risks"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "type": {
      "type": "string",
      "enum": ["ux_pattern", "logic_pattern", "layout_pattern", "motion_pattern", "conversion_pattern", "data_pattern"]
    },
    "use_case": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "good_for": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bad_for": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "complexity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "usability": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "mobile_quality": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requires_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "visible_h1",
          "dom_text_cta",
          "no_primary_content_in_canvas",
          "reduced_motion_fallback",
          "performance_budget",
          "proof_adjacency",
          "semantic_headings",
          "seo_readable_content",
          "accessible_copy",
          "responsive_typography",
          "trust_signal",
          "proof_evidence",
          "source_reference",
          "outcome_statement",
          "handoff_clarity",
          "brand_axis",
          "contrast_axis",
          "mobile_fallback",
          "asset_provenance",
          "asset_license",
          "demo_fallback",
          "navigation_recovery",
          "choice_model",
          "cta_path",
          "mobile_behavior",
          "accessible_links",
          "pointer_fallback",
          "keyboard_neutral_content",
          "section_anchors",
          "mobile_stacking",
          "effect_enhancement_only",
          "content_purpose",
          "content_readability",
          "visual_hierarchy",
          "line_length",
          "product_media_text",
          "pricing_clarity",
          "product_identity",
          "variant_availability_state",
          "purchase_action",
          "cart_management",
          "undo_path",
          "checkout_step_flow",
          "state_taxonomy",
          "error_state",
          "progress_indicator",
          "review_signal",
          "policy_information",
          "support_contact",
          "metric_definition",
          "comparison_context",
          "data_freshness",
          "data_source",
          "empty_loading_error_state",
          "filter_state",
          "date_range",
          "saved_view",
          "table_structure",
          "pagination_or_virtualization",
          "export_action",
          "chart_summary",
          "text_fallback",
          "severity_label",
          "timestamp",
          "ownership",
          "status_state",
          "dismissal_rule",
          "record_summary",
          "edit_state",
          "save_cancel_state",
          "focus_management",
          "selection_model",
          "permission_model",
          "confirmation_state",
          "audit_trail",
          "service_taxonomy",
          "search_affordance",
          "plain_language",
          "contact_fallback",
          "update_timestamp",
          "form_labeling",
          "validation_state",
          "office_contact",
          "account_state",
          "activity_summary",
          "document_metadata",
          "access_scope",
          "thread_state",
          "attachment_rule",
          "task_timeline",
          "server_enforcement"
        ]
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "accessibility_notes": {
      "type": "string"
    },
    "performance_notes": {
      "type": "string"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "modifiers": { "type": "array", "items": { "type": "string", "enum": ["motion", "positioning"] }, "default": [] }
  }
}
