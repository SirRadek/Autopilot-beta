{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowJs": false,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "product-design-os/scripts/validate-product-design-os.ts",
    "product-design-os/scripts/check-evidence-freshness-product-design-os.ts",
    "product-design-os/scripts/score-product-design-os.ts",
    "product-design-os/scripts/visual-qa-product-design-os.ts",
    "product-design-os/scripts/route-product-design-os.ts",
    "product-design-os/scripts/check-renderability-product-design-os.ts",
    "product-design-os/scripts/pattern-requirement-taxonomy.ts",
    "product-design-os/scripts/build-point-cloud-asset.ts",
    "product-design-os/qa/buildability-floor/check-buildability-floor-product-design-os.ts",
    "product-design-os/qa/fit-probe/**/*.ts",
    "product-design-os/qa/visual-qa-browser/**/*.ts",
    "product-design-os/qa/variants/sample-product-design-variants.ts",
    "product-design-os/renderer/**/*.ts"
  ]
}
