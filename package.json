{
  "name": "autopilot-beta",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Clean-install beta of the autopilot product-design-os floor (vendored from autopilot@<base-sha>). Separate product line; no shared git history with canonical.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pdos:validate": "tsx product-design-os/scripts/validate-product-design-os.ts",
    "pdos:score": "tsx product-design-os/scripts/score-product-design-os.ts",
    "pdos:visual-qa": "tsx product-design-os/scripts/visual-qa-product-design-os.ts",
    "pdos:renderability": "tsx product-design-os/scripts/check-renderability-product-design-os.ts",
    "pdos:buildability-floor": "tsx product-design-os/qa/buildability-floor/check-buildability-floor-product-design-os.ts",
    "pdos:variants": "tsx product-design-os/qa/variants/sample-product-design-variants.ts",
    "pdos:evidence-freshness": "tsx product-design-os/scripts/check-evidence-freshness-product-design-os.ts",
    "pdos:render": "tsx product-design-os/renderer/render-composition.ts",
    "beta:vendor-check": "node scripts/vendor-check.mjs",
    "beta:vendor-manifest": "node scripts/vendor-check.mjs --generate",
    "test": "vitest run",
    "verify": "npm run beta:vendor-check && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "25.9.3",
    "axe-core": "^4.12.1",
    "node-html-parser": "^8.0.3",
    "node-pty": "^1.1.0",
    "tsx": "^4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
