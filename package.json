{
  "name": "autopilot-beta",
  "version": "0.0.0",
  "private": true,
  "engines": { "node": ">=24 <25" },
  "workspaces": ["cockpit"],
  "type": "module",
  "description": "Clean-install beta of the autopilot product-design-os floor (vendored from autopilot@<base-sha>). Separate product line; no shared git history with canonical.",
  "scripts": {
    "prepare": "node scripts/git-hooks/install.mjs",
    "hooks:install": "node scripts/git-hooks/install.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docs:links": "tsx scripts/check-documentation-links.ts",
    "mesh:generate": "tsx scripts/generate-decision-mesh.ts",
    "promptlib:validate": "tsx scripts/validate-prompt-library.ts",
    "pdos:validate": "tsx product-design-os/scripts/validate-product-design-os.ts",
    "pdos:score": "tsx product-design-os/scripts/score-product-design-os.ts",
    "pdos:visual-qa": "tsx product-design-os/scripts/visual-qa-product-design-os.ts",
    "pdos:renderability": "tsx product-design-os/scripts/check-renderability-product-design-os.ts",
    "pdos:buildability-floor": "tsx product-design-os/qa/buildability-floor/check-buildability-floor-product-design-os.ts",
    "pdos:fit-safety-lint": "tsx product-design-os/qa/fit-safety/check-fit-safety-product-design-os.ts",
    "pdos:variants": "tsx product-design-os/qa/variants/sample-product-design-variants.ts",
    "pdos:evidence-freshness": "tsx product-design-os/scripts/check-evidence-freshness-product-design-os.ts",
    "pdos:render": "tsx product-design-os/renderer/render-composition.ts",
    "pdos:render:brands": "tsx product-design-os/renderer/render-brand-examples.ts",
    "pdos:route": "tsx product-design-os/scripts/route-product-design-os.ts",
    "pdos:report": "tsx product-design-os/scripts/route-product-design-os.ts --report",
    "pdos:library:projects": "tsx product-design-os/scripts/update-project-library.ts",
    "pdos:build-cloud": "tsx product-design-os/scripts/build-point-cloud-asset.ts",
    "model-output:validate": "tsx scripts/validate-model-output-evals.ts",
    "telemetry:summary": "tsx scripts/telemetry-summary.ts",
    "skills:discover": "tsx scripts/discover-skill-manifests.ts",
    "skills:curate": "tsx scripts/curate-skill-manifests.ts",
    "route:governed": "tsx scripts/route-governed-task.ts",
    "smoke:governed": "tsx scripts/smoke-governed-dispatch.ts",
    "approval:queue": "tsx scripts/approval-queue.ts",
    "approval:submit": "tsx scripts/approval-submit.ts",
    "approval:dispatch": "tsx scripts/approval-dispatch.ts",
    "control-plane:status": "tsx scripts/control-plane-status.ts",
    "control-plane:serve": "tsx scripts/control-plane-server.ts",
    "projects:init": "tsx scripts/project-registry-init.ts",
    "session:manager": "tsx scripts/session-manager.ts",
    "worker:status": "tsx scripts/worker-status.ts",
    "worker:cancel": "tsx scripts/worker-cancel.ts",
    "worker:cleanup": "tsx scripts/worker-cleanup.ts",
    "openrouter:health": "tsx scripts/openrouter-health.ts",
    "quota:agy": "tsx scripts/agy-quota.ts",
    "ops:backup": "tsx scripts/ops-backup.ts",
    "ops:restore": "tsx scripts/ops-restore.ts",
    "ops:recovery-drill": "tsx scripts/ops-recovery-drill.ts",
    "ops:maintenance": "tsx scripts/ops-maintenance.ts",
    "ops:boundary-check": "tsx scripts/ops-boundary-check.ts",
    "ops:health": "tsx scripts/ops-healthcheck.ts",
    "ops:ready": "tsx scripts/ops-readinesscheck.ts",
    "ops:cockpit-proxy:stage": "bash ops/cockpit-proxy/stage-release.sh",
    "ops:cockpit-proxy:isolated": "bash ops/cockpit-proxy/isolated-acceptance.sh",
    "ops:cockpit-proxy:host-acceptance": "bash ops/cockpit-proxy/host-acceptance.sh",
    "ops:cockpit-proxy:cutover": "bash ops/cockpit-proxy/live-cutover.sh",
    "beta:vendor-check": "node scripts/vendor-check.mjs",
    "beta:vendor-manifest": "node scripts/vendor-check.mjs --generate",
    "baseline:waiver-check": "node scripts/check-baseline-waivers.mjs",
    "test": "vitest run",
    "verify": "npm run beta:vendor-check && npm run typecheck && npm run test && npm run docs:links && npm run pdos:validate && npm run promptlib:validate && npm run pdos:renderability && npm run pdos:buildability-floor && npm run pdos:fit-safety-lint && npm run model-output:validate && npm run mesh:gate:ci",
    "pdos:fit-probe": "tsx product-design-os/qa/fit-probe/check-fit-probe-product-design-os.ts",
    "pdos:visual-qa-browser": "tsx product-design-os/qa/visual-qa-browser/check-visual-qa-browser-product-design-os.ts",
    "mesh:related-files-check": "tsx src/lib/mesh-tools/related-files-status-cli.ts",
    "mesh:gate": "tsx src/lib/mesh-tools/related-files-status-cli.ts --root . --nodes-subdir mesh/nodes",
    "mcp": "tsx mcp/server.ts",
    "governed-core:ipc": "tsx src/governed-core/ipc-server.ts",
    "mesh:gate:ci": "tsx src/lib/mesh-tools/related-files-status-cli.ts --root . --nodes-subdir mesh/nodes --baseline mesh/related-files-baseline.json --prior mesh/related-files-snapshot.json",
    "mesh:snapshot:regen": "tsx src/lib/mesh-tools/related-files-status-cli.ts --root . --nodes-subdir mesh/nodes --regen-snapshot mesh/related-files-snapshot.json",
    "mesh:changed": "tsx src/lib/mesh-tools/changed-files-capabilities-cli.ts"
    ,"cockpit:dev": "npm --prefix cockpit run dev"
    ,"cockpit:build": "npm --prefix cockpit run build"
    ,"cockpit:test": "npm --prefix cockpit run test"
    ,"browser:qa": "tsx scripts/browser-qa.ts"
    ,"browser:qa:proxy": "playwright test --config playwright.proxy.config.ts"
    ,"smoke:cockpit-run": "tsx scripts/smoke-cockpit-run.ts"
  },
  "dependencies": {
    "pngjs": "^7.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "@modelcontextprotocol/sdk": "^1.29.0"
    ,"react": "^19.1.0"
    ,"react-dom": "^19.1.0"
    ,"vite": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "25.9.3",
    "@types/pngjs": "^6.0.5",
    "axe-core": "^4.12.1",
    "node-html-parser": "^8.0.3",
    "node-pty": "^1.1.0",
    "tsx": "^4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
    ,"@types/react": "^19.1.0"
    ,"@types/react-dom": "^19.1.0"
  }
}
