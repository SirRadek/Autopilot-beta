#!/usr/bin/env sh
set -u

HOOK_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
. "$HOOK_DIR/lib.sh"

autopilot_cd_root

autopilot_run_npm "running fast mesh related_files ratchet" run mesh:gate:ci

staged_files="$(git diff --cached --name-only)"
if [ -z "$staged_files" ]; then
  printf '[autopilot:pre-commit] no staged files; skipping changed-files blocker gate\n'
  exit 0
fi

printf '\n[autopilot:pre-commit] checking staged files against blocker-governed mesh nodes\n'
printf '%s\n' "$staged_files" | autopilot_npm run mesh:changed -- --root . --fail-on-blocker
status="$?"
if [ "$status" -ne 0 ]; then
  autopilot_fail "$status" "staged changed-files blocker gate failed; commit blocked."
fi
