#!/usr/bin/env sh
set -u

HOOK_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
. "$HOOK_DIR/lib.sh"

autopilot_cd_root

base_ref="${AUTOPILOT_HOOK_BASE_REF:-origin/main}"
saw_update=0

while read -r local_ref local_sha remote_ref remote_sha
do
  [ -z "${local_ref:-}" ] && continue

  if autopilot_is_zero_sha "$local_sha"; then
    printf '[autopilot:pre-push] skipping deleted ref %s\n' "$remote_ref"
    continue
  fi

  local_commit="$(git rev-parse --verify "$local_sha^{commit}" 2>/dev/null || true)"
  if [ -z "$local_commit" ]; then
    printf '[autopilot:pre-push] skipping non-commit ref %s\n' "$local_ref"
    continue
  fi

  saw_update=1

  if autopilot_is_zero_sha "$remote_sha"; then
    if git rev-parse --verify --quiet "$base_ref" >/dev/null; then
      base_commit="$(git merge-base "$local_commit" "$base_ref" 2>/dev/null || true)"
    else
      base_commit=""
    fi

    if [ -z "$base_commit" ]; then
      base_commit="$(git hash-object -t tree /dev/null)"
    fi

    range="$base_commit..$local_commit"
  else
    remote_commit="$(git rev-parse --verify "$remote_sha^{commit}" 2>/dev/null || true)"
    if [ -z "$remote_commit" ]; then
      autopilot_fail 1 "cannot resolve remote commit $remote_sha for $remote_ref"
    fi
    range="$remote_commit..$local_commit"
  fi

  autopilot_run_npm "checking pushed range $range against blocker-governed mesh nodes" \
    run mesh:changed -- --root . --since "$range" --fail-on-blocker

  # Report-first (warn-only) self-approval gate: surfaces baseline-excuse growth added without a
  # `Baseline-Waiver:` commit trailer over the pushed range. Exits 0 by design, so it never blocks a
  # push; promotion to blocking is a deliberate owner-approved switch to `--strict` (P0.3).
  autopilot_run_npm "checking baseline-excuse waivers (report-first)" run baseline:waiver-check -- --range "$range"
done

if [ "$saw_update" -eq 0 ]; then
  printf '[autopilot:pre-push] no commit ref updates; skipping heavy gates\n'
  exit 0
fi

autopilot_run_npm "running TypeScript typecheck" run typecheck
autopilot_run_npm "running PDOS fit safety lint" run pdos:fit-safety-lint -- --no-pages
