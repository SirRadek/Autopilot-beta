# Vendored contracts are provenance-tracked by sha256 (beta:vendor-check).
# Disable ALL line-ending/text conversion so bytes survive clone/checkout
# identically to autopilot@<canonical_sha>. Without this, autocrlf would
# rewrite line endings on checkout and break the hash gate on a fresh clone.
* -text

# Git hook scripts must keep LF for Git Bash shebang execution.
scripts/git-hooks/pre-commit text eol=lf
scripts/git-hooks/commit-msg text eol=lf
scripts/git-hooks/pre-push text eol=lf
scripts/git-hooks/lib.sh text eol=lf
