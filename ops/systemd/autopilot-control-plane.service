[Unit]
Description=Autopilot governed control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=radek
Group=radek
WorkingDirectory=/home/radek/autopilot-beta
Environment=PATH=/usr/bin:/bin
Environment=TMPDIR=/home/radek/.local/state/.autopilot-runtime-tmp
Environment=AUTOPILOT_STATE_DIR=/home/radek/.local/state/autopilot
Environment=AUTOPILOT_PROJECTS_DIR=%h/projects
EnvironmentFile=/home/radek/.config/autopilot/control-plane.env
ExecStartPre=+/usr/bin/install -d -o radek -g radek -m 0700 %h/.local/state/.autopilot-runtime-tmp
ExecStartPre=+/usr/bin/install -d -m 0700 %h/.local/state/.autopilot-incident-spool
ExecStartPre=/usr/bin/npm run ops:boundary-check -- /home/radek/autopilot-beta ${AUTOPILOT_STATE_DIR} ${AUTOPILOT_PROJECTS_DIR}
ExecStart=/usr/bin/npm run control-plane:serve -- /home/radek/.local/state/autopilot 8787
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
# tmux usage probes communicate through /tmp/tmux-$UID; a private /tmp would hide that socket.
PrivateTmp=false
PrivateUsers=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/autopilot %h/.local/state/.autopilot-incident-spool %h/.local/state/.autopilot-runtime-tmp %h/projects
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
