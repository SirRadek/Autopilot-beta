[Unit]
Description=Validate, back up, and rotate Autopilot state
ConditionPathIsDirectory=/home/radek/.local/state/autopilot

[Service]
Type=oneshot
User=radek
Group=radek
WorkingDirectory=/home/radek/autopilot-beta
Environment=PATH=/usr/bin:/bin
ExecStartPre=+/usr/bin/install -d -o radek -g radek -m 0700 /home/radek/.local/state/.autopilot-incident-spool
ExecStart=/usr/bin/npm run ops:maintenance -- /home/radek/.local/state/autopilot /home/radek/.local/state/autopilot/backups /home/radek/.config/autopilot/control-plane.env --apply
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateUsers=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/radek/.local/state/autopilot /home/radek/.local/state/.autopilot-incident-spool
RestrictSUIDSGID=true
LockPersonality=true
