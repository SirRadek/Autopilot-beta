[Unit]
Description=Validate, back up, and rotate Autopilot state
ConditionPathIsDirectory=%h/.local/state/autopilot

[Service]
Type=oneshot
WorkingDirectory=/home/radek/autopilot-beta
Environment=PATH=/usr/bin:/bin
ExecStart=/usr/bin/npm run ops:maintenance -- %h/.local/state/autopilot %h/.config/autopilot/control-plane.env
ExecStart=/usr/bin/npm run ops:backup -- %h/.local/state/autopilot %h/.local/state/autopilot/backups
ExecStart=/usr/bin/npm run ops:maintenance -- %h/.local/state/autopilot %h/.config/autopilot/control-plane.env --apply-rotation
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateUsers=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/autopilot
RestrictSUIDSGID=true
LockPersonality=true
