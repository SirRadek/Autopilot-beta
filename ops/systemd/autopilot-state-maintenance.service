[Unit]
Description=Validate, back up, and rotate Autopilot state
ConditionPathIsDirectory=/home/radek/.local/state/autopilot

[Service]
Type=oneshot
WorkingDirectory=/home/radek/autopilot-beta
Environment=PATH=/home/radek/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/radek/.local/bin/npm run ops:maintenance -- /home/radek/.local/state/autopilot /home/radek/.config/autopilot/control-plane.env
ExecStart=/home/radek/.local/bin/npm run ops:backup -- /home/radek/.local/state/autopilot /home/radek/.local/state/autopilot-backups
ExecStart=/home/radek/.local/bin/npm run ops:maintenance -- /home/radek/.local/state/autopilot /home/radek/.config/autopilot/control-plane.env --apply-rotation
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/radek/.local/state/autopilot /home/radek/.local/state/autopilot-backups
RestrictSUIDSGID=true
LockPersonality=true
