[Unit]
Description=Verify Autopilot control-plane loopback health
After=autopilot-control-plane.service

[Service]
Type=oneshot
WorkingDirectory=/home/radek/autopilot-beta
Environment=PATH=/usr/bin:/bin
ExecStart=/usr/bin/npm run ops:health -- 8787
UMask=0077
NoNewPrivileges=true
PrivateUsers=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
