{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autopilot.local/schema/mcp-cross-1.json",
  "title": "Autopilot MCP Cross Manifest",
  "description": "Single canonical declaration of MCP servers, generated into each CLI's config. Read the world = MCP (readOnly); mutate the world = control plane. Secrets are referenced by ${ENV} only, never embedded.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "servers"],
  "properties": {
    "version": { "const": "autopilot.mcp-cross/1" },
    "servers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "transport", "readOnly", "toolAllowlist", "targets"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "transport": { "enum": ["stdio", "http"] },
          "command": { "type": "string" },
          "args": { "type": "array", "items": { "type": "string" } },
          "url": { "type": "string" },
          "readOnly": { "type": "boolean" },
          "toolAllowlist": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "targets": { "type": "array", "minItems": 1, "items": { "enum": ["claude", "codex", "agy"] } },
          "secretRefs": { "type": "array", "items": { "type": "string", "pattern": "^\\$\\{[A-Z0-9_]+\\}$" } }
        }
      }
    }
  }
}
