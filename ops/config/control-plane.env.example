CONTROL_PLANE_SECURE_COOKIES=false
# Production TLS deployments set both of these to true. REQUIRE is an independent
# fail-closed policy: readiness reports unavailable if secure cookies are required
# but CONTROL_PLANE_SECURE_COOKIES is not actually enabled.
CONTROL_PLANE_REQUIRE_SECURE_COOKIES=false
# Production provider CLIs are resolved only from this root-owned, checksummed directory.
AUTOPILOT_PROVIDER_CLI_BIN_DIR=/opt/autopilot-providers/bin
# Provider children receive the service PATH through the existing environment allowlist.
PATH=/opt/autopilot-providers/bin:/usr/bin:/bin
CONTROL_PLANE_USAGE_PROBES=
