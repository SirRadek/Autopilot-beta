table inet autopilot_cockpit {
	comment "autopilot-cockpit:__AUTOPILOT_COCKPIT_NONCE__"
	chain input {
		type filter hook input priority -10; policy accept;
		comment "autopilot-cockpit:__AUTOPILOT_COCKPIT_NONCE__"
		tcp dport { 80, 443 } ip saddr != 192.168.122.1 drop comment "autopilot-cockpit:__AUTOPILOT_COCKPIT_NONCE__"
	}
}
